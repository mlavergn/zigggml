#!/bin/bash
# Pulls upstream changes from llama.zig into zigggml (llama.zig drives syncs
# with upstream llama.cpp; see UPSTREAM.md).
#
# zigggml's Zig sources (src/, cli/cpu.zig, build/{metal_embed,cuda_kernels,
# vulkan_shaders}.zig) began as copies of llama.zig's but have been restyled
# to ZIGSTYLE.md, so they are never overwritten. This script:
#   - re-copies vendor/ggml/ from $LLAMA_ZIG/llama.cpp/ (LICENSE, ggml/include,
#     ggml/src/*.h, ggml-metal .m/.h/kernels, ggml-cuda,
#     ggml-vulkan/vulkan-shaders);
#   - lists what changed in llama.zig's src/ggml/ and those build tools since
#     the pinned llama.zig commit, for porting by hand;
#   - rewrites UPSTREAM.md's pin section from both checkouts.
#
# Usage: scripts/sync [LLAMA_ZIG]   (default ../llama.zig; or: make sync)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LZ="$(cd "${1:-$ROOT/../llama.zig}" && pwd)"
UP="$LZ/llama.cpp"
[ -f "$LZ/src/ggml/module.zig" ] || { echo "sync: $LZ is not a llama.zig checkout" >&2; exit 1; }
[ -f "$UP/ggml/include/ggml.h" ] || { echo "sync: $UP has no ggml/include/ggml.h" >&2; exit 1; }

cd "$ROOT"

# Zig sources are restyled here: report llama.zig's changes since the pin.
old_rev="$(sed -n 's/^- llama.zig: `\([0-9a-f]*\) .*/\1/p' UPSTREAM.md | head -1)"
if [ -n "$old_rev" ] && git -C "$LZ" cat-file -e "$old_rev" 2>/dev/null; then
    echo "llama.zig changes since $old_rev to port by hand:"
    git -C "$LZ" diff --stat "$old_rev" HEAD -- src/ggml build/metal_embed.zig build/cuda_kernels.zig \
        build/vulkan_shaders.zig build/llamacpp.zig tools/common/cpu.zig
else
    echo "sync: cannot find the pinned llama.zig commit; compare src/ by hand" >&2
fi

# Vendored upstream inputs.
V=vendor/ggml
rm -rf "$V"
mkdir -p "$V/src/ggml-metal" "$V/src/ggml-vulkan"
cp "$UP/LICENSE" "$V/LICENSE"
cp -a "$UP/ggml/include" "$V/include"
cp "$UP"/ggml/src/*.h "$V/src/"
cp "$UP"/ggml/src/ggml-metal/*.m "$UP"/ggml/src/ggml-metal/*.h "$V/src/ggml-metal/"
cp -a "$UP/ggml/src/ggml-metal/kernels" "$V/src/ggml-metal/"
cp -a "$UP/ggml/src/ggml-cuda" "$V/src/ggml-cuda"
cp -a "$UP/ggml/src/ggml-vulkan/vulkan-shaders" "$V/src/ggml-vulkan/"
rm -f "$V/src/ggml-cuda/CMakeLists.txt" "$V/src/ggml-vulkan/vulkan-shaders/CMakeLists.txt"

# UPSTREAM.md's pin section, between the markers.
lz_rev="$(git -C "$LZ" describe --tags --always 2>/dev/null || echo unknown) ($(git -C "$LZ" rev-parse --short HEAD 2>/dev/null || echo unknown))"
up_rev="$(git -C "$UP" describe --tags --always 2>/dev/null || echo unknown) ($(git -C "$UP" rev-parse --short=9 HEAD 2>/dev/null || echo unknown))"
pin="$(mktemp)"
{
    echo "<!-- pin:begin (written by scripts/sync) -->"
    echo "- llama.zig: \`$lz_rev\`"
    echo "- llama.cpp: \`$up_rev\`"
    echo "- synced: $(date -u +%Y-%m-%d)"
    echo "<!-- pin:end -->"
} > "$pin"
awk -v pinfile="$pin" '
    /<!-- pin:begin/ { while ((getline line < pinfile) > 0) print line; skip = 1; next }
    /<!-- pin:end/   { skip = 0; next }
    !skip
' UPSTREAM.md > UPSTREAM.md.tmp && mv UPSTREAM.md.tmp UPSTREAM.md
rm -f "$pin"

echo "synced from $LZ: llama.zig $lz_rev, llama.cpp $up_rev"
echo "next: port the listed changes into src/ (restyled), make validate, compare symbols (see UPSTREAM.md)"
